PORT=8082
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:4200
# Same database used by the original Spring project:
MYSQL_URL=jdbc:mysql://localhost:3306/sentinel_db_in5bm?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true    
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sentinel_db_in5bm
DB_USERNAME=IN5BM
DB_PASSWORD=your-database-password
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=25000
EMERGENCY_BOMBEROS=123
EMERGENCY_POLICIA=122
# Default admin user (used only if DB is empty on first run)
DEFAULT_ADMIN_NOMBRE=Administrador SENTINEL
DEFAULT_ADMIN_EMAIL=admin@sentinel.local
DEFAULT_ADMIN_PASSWORD=sentinel
DEFAULT_ADMIN_ROL=ADMIN
DEFAULT_ADMIN_PIN=0000
# Default values for new users
DEFAULT_USER_ROL=USER
DEFAULT_USER_PIN=0000
DEFAULT_USER_PASSWORD=sentinel
